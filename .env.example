# Copy to .env and fill in. .env is git-ignored.
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=COMMERCE_SVC
# Path to the unencrypted PKCS#8 private key created in docs/RUNBOOK_SNOWFLAKE.md
SNOWFLAKE_PRIVATE_KEY_PATH=/home/you/.snowflake/commerce_svc_key.p8
SNOWFLAKE_DATABASE=COMMERCE_DB
SNOWFLAKE_LOAD_ROLE=LOADER_ROLE
SNOWFLAKE_LOAD_WAREHOUSE=LOAD_WH
SNOWFLAKE_TRANSFORM_ROLE=TRANSFORMER_ROLE
SNOWFLAKE_TRANSFORM_WAREHOUSE=TRANSFORM_WH
